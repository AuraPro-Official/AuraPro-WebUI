# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''
ENV='prod'

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='http://localhost:5173'

# Trust forwarded headers only from the local desktop proxy by default.
FORWARDED_ALLOW_IPS='127.0.0.1,::1'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

RAG_TOP_K=30
RAG_EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"
RAG_TOP_K_RERANKER=30
RAG_RERANKING_MODEL="BAAI/bge-reranker-base"

# EPUB Concept Search: local-only Tier-2 concept resolver (llama.cpp).
# The service listens only on the loopback interface; no cloud fallback is permitted.
# 18881 is llama-server's port; 8081 is WebUI's own, and pointing this at WebUI
# meant Tier-2 could only ever fail.  A Desktop install ignores this entirely and
# uses AURAPRO_DESKTOP_LLM_RUNTIME_FILE instead, since Desktop repicks the port.
#
# No model is named here on purpose.  Tier-2 asks llama.cpp which model it is
# already holding (GET /v1/models) and borrows that one, so it cannot evict the
# model the user is chatting with.  A plain `llama-server -m <model>.gguf` works
# too: it reports no load state, so its single listed model is taken as resident.
# EPUB_CONCEPT_LOCAL_LLM_MODEL is still read, but only as a tie-breaker for a
# runtime holding several models at once -- and note such a runtime reports each
# model's full filesystem path as its id, which a short name will not match.
EPUB_CONCEPT_LOCAL_LLM_ENDPOINT="http://127.0.0.1:18881"
EPUB_CONCEPT_LOCAL_LLM_TIMEOUT_SECONDS="30"
EPUB_CONCEPT_LOCAL_LLM_MAX_TOKENS="96"
RELEVANCE_THRESHOLD=0.6

# Model device is deliberately NOT pinned here.  `env.py` already resolves it
# per host: `cuda` when USE_CUDA_DOCKER=true, otherwise `mps` on macOS and `cpu`
# elsewhere.  Hardcoding "cuda" here overrode that on every machine, and on a Mac
# it took the vector *and* fused channels down with
# "RAG CUDA acceleration is enabled, but PyTorch cannot access CUDA" -- leaving
# EPUB search silently graph-only.  Set USE_CUDA_DOCKER=true for a CUDA host, or
# override RAG_EMBEDDING_MODEL_DEVICE_TYPE / RAG_RERANKING_MODEL_DEVICE_TYPE in
# the environment for a one-off; do not put a device back in this file.

ENABLE_RAG_HYBRID_SEARCH=true
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT=6000
# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
